{
  "expo": {
    "name": "Plan It!",
    "slug": "lets-plan-it",
    "owner": "chookities-team",
    "version": "1.0.0",
    "extra": {
      "eas": {
        "projectId": "1db9aef0-1f5b-4736-ae58-13a37c64c129"
      }
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#2C7952"
    },
    "ios": {
      "bundleIdentifier": "com.emurekun.planit",
      "buildNumber": "1",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.emurekun.planit",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#2C7952",
        "foregroundImage": "./assets/adaptive-icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
