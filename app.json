{
  "expo": {
    "name": "Plan It!",
    "slug": "lets-plan-it",
    "owner": "chookities-team",
    "version": "1.0.0",
    "extra": {
      "eas": {
        "projectId": "1db9aef0-1f5b-4736-ae58-13a37c64c129"
      }
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#2C7952"
    },
    "ios": {
      "bundleIdentifier": "com.emurekun.planit",
      "buildNumber": "2",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.emurekun.planit",
      "versionCode": 2,
      "adaptiveIcon": {
        "backgroundColor": "#2C7952",
        "foregroundImage": "./assets/adaptive-icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-2574865816195164~9091636938",
          "iosAppId": "ca-app-pub-3940256099942544~1458002511"
        }
      ]
    ]
  }
}
